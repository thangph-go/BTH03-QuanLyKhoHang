<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chi tiết sản phẩm"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin và tình trạng hàng hóa trong kho"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp" />

        <!-- Product information card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THÔNG TIN SẢN PHẨM"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên sản phẩm"
                android:textColor="@color/text_primary"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginBottom="9dp" />

            <TextView
                android:id="@+id/tvDetailCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loại sản phẩm: Điện tử"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="15dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GIÁ BÁN"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvDetailPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="150.000 VNĐ"
                android:textColor="@color/primary"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <!-- Inventory information card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THÔNG TIN TỒN KHO"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="15dp" />

            <TextView
                android:id="@+id/tvDetailQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số lượng tồn: 20"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailInventoryValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Giá trị tồn kho: 3.000.000 VNĐ"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvDetailLowStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SẮP HẾT HÀNG"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@color/danger_light"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:layout_marginTop="13dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Description card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MÔ TẢ SẢN PHẨM"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có mô tả"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Stock action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnAddStock"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:text="Nhập thêm 1"
                android:textAllCaps="false"
                android:textColor="@color/surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSellOne"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:text="Bán 1"
                android:textAllCaps="false"
                android:textColor="@color/surface"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Back button -->
        <Button
            android:id="@+id/btnDetailBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:backgroundTint="@null"
            android:text="Quay lại"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Delete button -->
        <Button
            android:id="@+id/btnDeleteProduct"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_danger"
            android:backgroundTint="@null"
            android:text="Xóa sản phẩm"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
